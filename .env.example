# =========================================================================
# WikiMe - Local Development Environment Variables (.env.example)
# Copy this file to .env before starting services: cp .env.example .env
# =========================================================================

# Database (PostgreSQL 16)
POSTGRES_DB=wikime
POSTGRES_USER=wikime_dev
POSTGRES_PASSWORD=wikime_dev_secret
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://wikime_dev:wikime_dev_secret@localhost:5432/wikime

# Cache & Message Broker (Redis Stack)
REDIS_PORT=6379
REDIS_UI_PORT=8001
REDIS_URL=redis://localhost:6379/0

# Vector Database (Qdrant)
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_REST_URL=http://localhost:6333
QDRANT_GRPC_URL=http://localhost:6334

# Application Services
AI_SERVICE_URL=http://localhost:8080
BACKEND_SERVICE_URL=http://localhost:8000
WEB_SERVICE_URL=http://localhost:3000
